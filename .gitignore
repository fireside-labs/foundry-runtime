# ============================================================================
# Foundry Runtime — .gitignore
#
# Source-only public repo. Binaries ship via GitHub Releases, never via git.
# ============================================================================

# Rust / Cargo build output
src-tauri/target/
src-tauri/Cargo.lock.bak

# Tauri-generated files
src-tauri/gen/

# Node / npm (frontend dev tooling, if any)
node_modules/
dist/
out/
.next/

# Built binaries — these belong in GitHub Releases, not the source repo.
# Each release's build script stages the platform-appropriate binaries into
# src-tauri/binaries/ and the Tauri bundler embeds them in the MSI/DMG.
*.exe
*.dll
*.msi
*.app
*.dmg
*.deb
*.rpm
*.AppImage
# macOS-specific: dylibs and the no-extension llama-server executable.
*.dylib
src-tauri/binaries/llama-server

# Model weights — too large for git, distributed separately
*.gguf
*.safetensors
*.bin
*.pt
*.pth
*.ckpt

# Secrets / per-user runtime state — never commit
license.key
.env
.env.*
!.env.example
*.pem
*.p12
*.pfx
*.key
secrets.json

# OS junk
.DS_Store
Thumbs.db
desktop.ini

# Editor / IDE
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*.swo
*~

# Logs
*.log
logs/
npm-debug.log*

# Tauri code-signing artifacts (when set up)
src-tauri/.cargo/
src-tauri/private-keys/

# Local dev scratch — never push
scratch/
todo.local.md
NOTES.local.md

# Vercel (in case this repo is ever wired to Vercel for the dashboard)
.vercel/
